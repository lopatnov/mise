{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome ci src/",
    "format": "biome check --write src/",
    "preview": "vite preview",
    "preview:test": "vite preview --port 4173 --strictPort",
    "check:locales": "node scripts/check-locales.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "a11y:scan": "pa11y-ci --config .pa11yci.json",
    "test:a11y": "start-server-and-test preview:test http://localhost:4173 a11y:scan"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "pa11y-ci": "^4.1.1",
    "sass": "^1.102.0",
    "start-server-and-test": "^3.0.12",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
